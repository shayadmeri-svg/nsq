{
  "_about": "Default settings of the plant simulator (simulator.py). Eurveda's Sim engine panel edits a copy; the simulator reads it every few seconds. Patterns: steady | drift | sine | step | spikes | ramp. 'per': batch = drawn once when a batch starts; reading = every reading.",
  "running": true,
  "speed": 30,
  "handling_min": 5,
  "apparatus": {
    "RMG-1": {
      "label": "Rapid mixer granulator", "format": "rmg", "enabled": true, "duration_min": 15,
      "signals": {
        "dry_mix_kg": {"label": "Dry mix", "unit": "kg", "per": "batch", "setpoint": 100, "noise": 0, "min": 20, "max": 300, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "binder_kg": {"label": "Binder solution added", "unit": "kg", "per": "batch", "setpoint": 25, "noise": 0.6, "min": 5, "max": 60, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "wet_mix_min": {"label": "Wet mixing time", "unit": "min", "per": "batch", "setpoint": 4, "noise": 0.3, "min": 0.5, "max": 15, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "impeller_kw": {"label": "Impeller power", "unit": "kW", "per": "reading", "setpoint": 7.5, "noise": 0.25, "min": 0, "max": 30, "pattern": "ramp", "amplitude": 3, "every": 3, "period_min": 60}
      }
    },
    "FBD-1": {
      "label": "Fluid-bed dryer", "format": "fbd", "enabled": true, "duration_min": 60,
      "signals": {
        "drying_min": {"label": "Drying time", "unit": "min", "per": "batch", "setpoint": 60, "noise": 1.5, "min": 10, "max": 150, "pattern": "step", "amplitude": -21, "every": 3, "period_min": 60},
        "inlet_c": {"label": "Inlet air temperature", "unit": "°C", "per": "reading", "setpoint": 60, "noise": 0.6, "min": 25, "max": 95, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "inlet_rh_pct": {"label": "Inlet relative humidity", "unit": "%RH", "per": "reading", "setpoint": 8, "noise": 0.6, "min": 0.5, "max": 90, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "air_m3_h": {"label": "Air flow", "unit": "m³/h", "per": "reading", "setpoint": 3000, "noise": 25, "min": 500, "max": 6000, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60}
      }
    },
    "BLENDER-1": {
      "label": "Blender", "format": "blender", "enabled": true, "duration_min": 10,
      "signals": {
        "blend_min": {"label": "Lubricated blend time", "unit": "min", "per": "batch", "setpoint": 5, "noise": 0.3, "min": 0.5, "max": 40, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "blender_rpm": {"label": "Blender speed", "unit": "rpm", "per": "reading", "setpoint": 12, "noise": 0.2, "min": 2, "max": 40, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60}
      }
    },
    "PRESS-1": {
      "label": "Tablet press", "format": "press", "enabled": true, "duration_min": 45,
      "signals": {
        "force_kn": {"label": "Main compression force", "unit": "kN", "per": "reading", "setpoint": 13, "noise": 0.35, "min": 1, "max": 60, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "precompression_kn": {"label": "Pre-compression force", "unit": "kN", "per": "reading", "setpoint": 2, "noise": 0.12, "min": 0, "max": 10, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "tablet_weight_mg": {"label": "Tablet weight", "unit": "mg", "per": "reading", "setpoint": 650, "noise": 6.5, "min": 100, "max": 1500, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "punch_diameter_mm": {"label": "Punch diameter", "unit": "mm", "per": "batch", "setpoint": 12, "noise": 0, "min": 5, "max": 25, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60},
        "press_rpm": {"label": "Turret speed", "unit": "rpm", "per": "reading", "setpoint": 30, "noise": 0, "min": 5, "max": 90, "pattern": "steady", "amplitude": 0, "every": 3, "period_min": 60}
      }
    }
  }
}
