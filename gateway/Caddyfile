# HTTPS in front of the nginx gateway (compose profile "https"). Caddy gets and renews the Let's Encrypt
# certificate for $DOMAIN by itself; ports 80 and 443 must be open and the domain's A record must point here.
# Server-sent events (job logs, plant monitor) stream through: Caddy flushes text/event-stream immediately.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy gateway:80
}
