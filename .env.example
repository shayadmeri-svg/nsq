# Copy to .env and fill in. Never commit .env (it is gitignored).

# Upstash (rediss://...) — the upstream/backup copy of the dataset. The app
# itself reads the in-server `redis` container; only the Sync and refresh
# jobs (Admin → Data jobs, or ./pull-upstash.sh) talk to Upstash.
REDIS_URL=

# Postgres for users, orgs, audit, jobs. Either a managed database (Neon,
# RDS...) — paste the provider's URL as-is, 'postgresql://...' is fine:
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# ...or leave DATABASE_URL unset and run the local container: docker compose --profile local-db up -d
POSTGRES_PASSWORD=

# First super admin, created on first boot if the email does not exist yet.
# Change the password from the Account page after the first sign-in.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Public URL of the app — used to build invite links.
APP_BASE_URL=http://localhost

# Set to true once the site is served over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false

# Optional: session lifetime (hours of inactivity).
SESSION_TTL_HOURS=12

# Optional: host port for the gateway (defaults to 80).
GATEWAY_PORT=80

# Optional escape hatch: point the API at a different Redis than the in-server one.
# NSQ_REDIS_URL=

# Optional — kept for the legacy Streamlit services only.
GEMINI_API_KEY=

# Data pipelines: schedules run inside the API. off = never run on a schedule.
SCHEDULER=on
SCHEDULE_TZ=Asia/Kolkata
# Min NSQ alerts for an ingredient to join the molecule universe; cap on auto molecules.
UNIVERSE_MIN_ALERTS=5
UNIVERSE_MAX_AUTO=250
