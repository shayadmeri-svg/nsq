# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# Redis — the only required setting. Upstash needs the TLS scheme (rediss://);
# a local Redis is plain redis://. From inside the compose network a Redis
# running on your host is reachable as host.docker.internal.
REDIS_URL=

# Optional — a Gemini API key switches the simulator's D3 diagnostics from the
# local heuristic engine to live generative output. Leave empty to stay fully
# offline (the "unset" path).
GEMINI_API_KEY=

# Optional — which tenant the legacy Streamlit manufacturer app (:8503)
# scopes to. It does NOT affect the React app / manufacturer-api: those take
# the tenant from the request path instead.
NSQ_TENANT=regent-ajanta-biotech

# Optional — only used by the Vite dev server (host-side `just run-web`).
# In the compose/production topology the gateway serves the SPA and the API
# from one origin, so no CORS is involved.
MANUFACTURER_API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional — host port for the gateway, the single entry point that serves
# every service under a path (/, /analytics/, /simulator/, /manufacturer/,
# /engine/). Defaults to 80. Set it to 8080 if a system nginx already owns
# port 80 on the box, and put deploy/nginx-host.conf in front of it.
GATEWAY_PORT=80
